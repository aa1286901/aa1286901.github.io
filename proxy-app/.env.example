# Environment variables for ahmedov.proxy
# Copy this file to .env and fill in your values

# Database path (relative to project root)
DB_PATH=database/app.db

# JWT secret (change this in production!)
JWT_SECRET=your-secure-jwt-secret-here

# JWT TTL in seconds (default 30 days)
JWT_TTL_SECONDS=2592000

# Admin phone number (10 digits, without +7)
ADMIN_PHONE=7777777777

# Admin key for API access
ADMIN_KEY=your-admin-key-here

# Frontend origins for CORS (comma-separated)
FRONTEND_ORIGIN=*

# Support URL
SUPPORT_URL=https://wa.me/79990000000

# Platega SBP gateway
PLATEGA_MERCHANT_ID=your-merchant-id
PLATEGA_SECRET=your-platega-secret
PLATEGA_API_BASE=https://app.platega.io
PLATEGA_CURRENCY=RUB
